# ShopiSpy — environment variables
# Copy this file to .env.local for local dev, and set each key in the
# Vercel dashboard (Settings → Environment Variables) for preview + prod.
#
# Lines starting with NEXT_PUBLIC_ are exposed to the browser. Everything
# else is server-only and must never be committed or sent to the client.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Find these under Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key — server-only. Used by cron routes, Stripe webhook,
# and /api/admin/setup. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# Stripe Dashboard → Developers → API keys. Use the test key in preview,
# live key in production.
STRIPE_SECRET_KEY=sk_test_...

# Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret.
# Must match the webhook endpoint configured for this deployment's domain.
STRIPE_WEBHOOK_SECRET=whsec_...

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------
# Shared secret Vercel Cron presents as `Authorization: Bearer <value>` when
# hitting /api/cron/*. Generate with: `openssl rand -hex 32`.
# If unset in dev, cron routes accept unauthenticated requests.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
# Guards /api/admin/setup. Set to a long random string; used once to
# bootstrap the first admin user, then can be rotated.
ADMIN_SETUP_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Base URL used for OAuth redirect fallback. Defaults to window.location.origin
# on the client; set explicitly in production so server-rendered links resolve.
NEXT_PUBLIC_SITE_URL=https://shopi-spy.com
